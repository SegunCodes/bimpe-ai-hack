PORT=3001
MOCK_CALLS=true

# Automatic scheduled calls (see "Scheduled calls" in README.md)
SCHEDULER_INTERVAL_MS=15000
RETRY_DELAY_MINUTES=30
MAX_CALL_ATTEMPTS=3
DATABASE_URL=mysql://bimpe:bimpe-local-password@127.0.0.1:3306/bimpe_calls

BIMPE_API_KEY=
BIMPE_DELIVERY_AGENT_ID=
BIMPE_ONBOARDING_AGENT_ID=
# Optional fallback for a single shared agent ID.
BIMPE_AGENT_ID=
BIMPE_IS_TEST_CALL=true

WEBHOOK_SECRET=change-me-for-real-webhooks
PUBLIC_BASE_URL=http://localhost:3001
