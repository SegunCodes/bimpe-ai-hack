PORT=3001
MOCK_CALLS=true

# Postgres. Production: Neon's *pooled* connection string (Neon dashboard → Connect → "Pooled connection").
# Local: the docker compose database below, or your own Neon dev branch.
DATABASE_URL=postgresql://tellero:tellero-local-password@127.0.0.1:5432/tellero

# Protects GET/POST /api/cron/tick. Use a long random value in production.
CRON_SECRET=change-me
# Local / always-on servers only: how often background work runs (ms)
TICK_INTERVAL_MS=5000
# Minimum gap between ticks triggered by dashboard requests (ms)
TICK_MIN_GAP_MS=5000

# Automatic scheduled calls (see "Scheduled calls" in README.md)
RETRY_DELAY_MINUTES=30
MAX_CALL_ATTEMPTS=3

BIMPE_API_KEY=
BIMPE_DELIVERY_AGENT_ID=
BIMPE_ONBOARDING_AGENT_ID=
# Optional fallback for a single shared agent ID.
BIMPE_AGENT_ID=
# Test calls until you set this to false (needs an approved number linked to the agent)
BIMPE_IS_TEST_CALL=true

WEBHOOK_SECRET=change-me-for-real-webhooks
PUBLIC_BASE_URL=http://localhost:3001

# Password for the platform owner's /admin page (all businesses). Use a long one.
ADMIN_PASSWORD=

# Business accounts sign in with email + password. Sessions are signed with SESSION_SECRET,
# or a value derived from CRON_SECRET if unset. Changing it signs every business out.
SESSION_SECRET=

# Plan payments (Paystack). Without a key, plans can only be switched on from /admin.
# In the Paystack dashboard, set the webhook URL to https://<this-backend>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
# The dashboard's address, where Paystack sends businesses back after paying.
APP_URL=https://www.usetellero.com

# Shared limits (all businesses use one BimpeAI account)
# BimpeAI telephony minutes per month (plan + wallet). /admin can change this month's number.
BIMPE_MONTHLY_MINUTES=200
# Most calls on the phone at the same time.
MAX_CONCURRENT_CALLS=3
# What one BimpeAI minute costs you in naira, for the admin estimates.
BIMPE_COST_PER_MINUTE=200

# Email (Resend). Sign-up codes, welcome, CAC received/approved/rejected, plan active.
# The sending domain (usetellero.com) must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Tellero AI <no-reply@usetellero.com>
EMAIL_REPLY_TO=support@usetellero.com
# Where "a business uploaded its CAC certificate" alerts go.
ADMIN_NOTIFY_EMAIL=support@usetellero.com
